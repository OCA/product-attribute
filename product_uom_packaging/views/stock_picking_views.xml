<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_picking_form_inherit_package_warning" model="ir.ui.view">
        <field name="name">stock.picking.form.inherit.package.warning</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form" />
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('alert', 'alert-info')]" position="after">
                <div
                    class="alert alert-warning"
                    role="alert"
                    invisible="not has_package_incompatibility"
                >
                    <strong>Package Compatibility Warning:</strong>
                    <field name="package_incompatibility_warning" class="ms-2" />
                </div>
            </xpath>
        </field>
    </record>
</odoo>
