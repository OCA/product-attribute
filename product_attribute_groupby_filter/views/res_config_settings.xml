<odoo>

    <record id="res_config_settings_view_form_groupby" model="ir.ui.view">
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//div[@id='manage_volume_uom_setting']" position="after">
                <div class="col-12 col-lg-6 o_setting_box">
                    <div class="o_setting_left_pane" />
                    <div class="o_setting_right_pane">
                        <label
                            for="product_groupby_attribute_sort"
                            string="Attribute values sort order"
                        />
                        <div class="text-muted">
                            Sort order applied to attribute values when
                            grouping products by attribute in the searchbar.
                        </div>
                        <field name="product_groupby_attribute_sort" />
                    </div>
                </div>
            </xpath>
        </field>
    </record>

</odoo>
