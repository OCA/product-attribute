<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Product Template Form - Unit Conversions on Inventory tab -->
    <record id="view_product_template_form_uom_factor" model="ir.ui.view">
        <field name="name">product.template.form.uom.factor</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//page[@name='inventory']" position="inside">
                <group string="Unit Conversions" name="uom_conversions" colspan="2">
                    <field name="uom_factor_ids" nolabel="1" colspan="2">
                        <list editable="bottom">
                            <field name="product_tmpl_id" column_invisible="True" />
                            <field name="uom_id" readonly="1" />
                            <field
                                name="product_ids"
                                widget="many2many_tags"
                                placeholder="All variants"
                                domain="[('product_tmpl_id', '=', parent.id)]"
                            />
                            <field name="factor" />
                        </list>
                    </field>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
