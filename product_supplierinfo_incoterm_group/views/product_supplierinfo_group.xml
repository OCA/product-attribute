<odoo>
    <record id="supplierinfo_group_view_form" model="ir.ui.view">
        <field name="model">product.supplierinfo.group</field>
        <field
            name="inherit_id"
            ref="product_supplierinfo_group.supplierinfo_group_view_form"
        />
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field name="incoterm_id" />
            </field>
        </field>
    </record>
    <record id="supplierinfo_group_view_list" model="ir.ui.view">
        <field name="model">product.supplierinfo.group</field>
        <field
            name="inherit_id"
            ref="product_supplierinfo_group.supplierinfo_group_view_list"
        />
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field name="incoterm_id" />
            </field>
        </field>
    </record>
</odoo>
