msgid ""
"%(base)s from %(min)s to %(max)s: %(discount)s%% discount and %(price_surcharge)s extra fee and %(surcharge)s surcharge\n"
" - Example: %(amount)s * %(discount_charge)s + %(price_surcharge)s + %(surcharge)s → %(total_amount)s \n"
