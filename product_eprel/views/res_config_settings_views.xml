<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.eprel.api</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='recaptcha']" position="after">
                <setting
                    id="eprel_integration"
                    documentation="https://webgate.ec.europa.eu/fpfis/wikis/x/PYbLJ"
                    string="Eprel Integration"
                >
                    <div class="text-muted">
                Authentication key for accessing EPREL product data via API
                        </div>
                    <div class="content-group mt16">
                        <label for="eprel_api_key" class="o_light_label" />
                        <field name="eprel_api_key" password="True" />
                    </div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
