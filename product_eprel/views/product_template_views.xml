<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_product_template_form_eprel" model="ir.ui.view">
        <field name="name">product.template.form.eprel</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <field name="eprel_enabled" />
                <button
                    name="action_get_eprel_registration_number"
                    type="object"
                    string="Get EPREL data"
                    attrs="{'invisible': [('eprel_enabled', '=', False)]}"
                />
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="EPREL">
                    <group attrs="{'invisible': [('eprel_enabled', '=', False)]}">
                        <field name="eprel_model_identifier" />
                        <field name="fiche_url" widget="url" />
                        <field name="label_url" widget="url" />
                        <field name="label_arrow_url" widget="url" />
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
