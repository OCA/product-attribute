<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="product_packaging_list_view" model="ir.ui.view">
        <field name="model">product.packaging</field>
        <field name="inherit_id" ref="product_packaging.product_packaging_list_view" />
        <field name="arch" type="xml">
            <field name="product_uom_id" position="after">
                <field name="packaging_length" optional="show" />
                <field name="width" optional="show" />
                <field name="height" optional="show" />
            </field>
        </field>
    </record>

    <record id="product_packaging_form_view" model="ir.ui.view">
        <field name="model">product.packaging</field>
        <field name="inherit_id" ref="product_packaging.product_packaging_form_view" />
        <field name="arch" type="xml">
            <group name="package" position="before">
                <group name="dimensions" string="Dimensions">
                    <group id="group_packaging_length">
                        <label for="packaging_length" />
                        <div class="o_row">
                            <field name="packaging_length" />
                            <field name="length_uom_name" />
                        </div>
                    </group>
                    <group id="group_width">
                        <label for="width" />
                        <div class="o_row">
                            <field name="width" />
                            <field name="length_uom_name" />
                        </div>
                    </group>
                    <group id="group_height">
                        <label for="height" />
                        <div class="o_row">
                            <field name="height" />
                            <field name="length_uom_name" />
                        </div>
                    </group>
                </group>
            </group>
        </field>
    </record>
</odoo>
