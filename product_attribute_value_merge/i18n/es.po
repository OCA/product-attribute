#. module: product_attribute_value_merge
#. odoo-python
#: code:addons/product_attribute_value_merge/wizards/product_attribute_value_merge_wizard.py:0
msgid ""
"%(count)s %(model)s hold the merged values in %(field)s, which is company "
"dependent: they are not moved."
msgstr ""
"%(count)s %(model)s tienen los valores fusionados en %(field)s, que depende "
"de la compañía: no se mueven."

#. module: product_attribute_value_merge
#. odoo-python
#: code:addons/product_attribute_value_merge/models/product_attribute_value_merge.py:0
msgid ""
"%(count)s of %(total)s %(model)s (%(field)s) were changed after the merge "
"and keep their current value."
msgstr ""
"%(count)s de %(total)s %(model)s (%(field)s) cambiaron después de la fusión "
"y mantienen su valor actual."

#. module: product_attribute_value_merge
#. odoo-python
#: code:addons/product_attribute_value_merge/wizards/product_attribute_value_merge_wizard.py:0
msgid ""
"%(count)s rows of the table %(table)s (column %(column)s) point to the "
"merged values but belong to no installed module: they are not moved."
msgstr ""
"%(count)s filas de la tabla %(table)s (columna %(column)s) apuntan a los "
"valores fusionados pero no pertenecen a ningún módulo instalado: no se "
"mueven."

#. module: product_attribute_value_merge
#. odoo-python
#: code:addons/product_attribute_value_merge/models/product_attribute_value_merge.py:0
msgid ""
"%(field)s of %(value)s was changed after the merge and is left as it is."
msgstr ""
"%(field)s de %(value)s cambió después de la fusión y se deja como está."

#. module: product_attribute_value_merge
#. odoo-python
#: code:addons/product_attribute_value_merge/models/product_attribute_value_merge.py:0
msgid ""
"%(model)s (%(field)s) can no longer be restored: %(count)s records keep "
"%(keeper)s."
msgstr ""
"%(model)s (%(field)s) ya no se puede restaurar: %(count)s registros "
"mantienen %(keeper)s."

#. module: product_attribute_value_merge
#. odoo-python
#: code:addons/product_attribute_value_merge/wizards/product_attribute_value_merge_wizard.py:0
msgid ""
"%(value)s has the external id %(xmlid)s: code or data using it will reach "
"the archived value."
msgstr ""
"%(value)s tiene el ID externo %(xmlid)s: el código o los datos que lo usen "
"llegarán al valor archivado."

