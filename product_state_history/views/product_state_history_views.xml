<odoo>
    <record id="view_product_state_history_list" model="ir.ui.view">
        <field name="name">product.state.history.list</field>
        <field name="model">product.state.history</field>
        <field name="arch" type="xml">
            <list create="false" edit="false">
                <field name="date" />
                <field name="product_tmpl_id" />
                <field name="old_state_id" />
                <field name="new_state_id" />
                <field name="user_id" />
                <field name="reason" />
            </list>
        </field>
    </record>
    <record id="view_product_state_history_form" model="ir.ui.view">
        <field name="name">product.state.history.form</field>
        <field name="model">product.state.history</field>
        <field name="arch" type="xml">
            <form create="false">
                <sheet>
                    <group>
                        <group>
                            <field name="product_tmpl_id" readonly="1" />
                            <field name="date" readonly="1" />
                            <field name="user_id" readonly="1" />
                        </group>
                        <group>
                            <field name="old_state_id" readonly="1" />
                            <field name="new_state_id" readonly="1" />
                        </group>
                    </group>
                    <group string="Reason">
                        <field name="reason" nolabel="1" colspan="2" readonly="1" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_product_state_history_search" model="ir.ui.view">
        <field name="name">product.state.history.search</field>
        <field name="model">product.state.history</field>
        <field name="arch" type="xml">
            <search>
                <field name="product_tmpl_id" />
                <field name="old_state_id" />
                <field name="new_state_id" />
                <field name="user_id" />
                <field name="reason" />
                <filter
                    name="filter_my_changes"
                    string="My Changes"
                    domain="[('user_id', '=', uid)]"
                />
                <group>
                    <filter
                        name="groupby_product"
                        string="Product"
                        context="{'group_by': 'product_tmpl_id'}"
                    />
                    <filter
                        name="groupby_new_state"
                        string="New State"
                        context="{'group_by': 'new_state_id'}"
                    />
                    <filter
                        name="groupby_user"
                        string="Changed by"
                        context="{'group_by': 'user_id'}"
                    />
                    <filter
                        name="groupby_date"
                        string="Date"
                        context="{'group_by': 'date'}"
                    />
                </group>
            </search>
        </field>
    </record>
    <record id="action_product_state_history" model="ir.actions.act_window">
        <field name="name">Product State History</field>
        <field name="res_model">product.state.history</field>
        <field name="view_mode">list,form</field>
        <field name="context">{}</field>
    </record>
</odoo>
