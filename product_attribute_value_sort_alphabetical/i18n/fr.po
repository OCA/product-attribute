#. module: product_attribute_value_sort_alphabetical
#: model:ir.model.fields,field_description:product_attribute_value_sort_alphabetical.field_product_attribute__keep_manual_sort
msgid "Keep Manual Sort"
msgstr "Garder un tri manuel"

#. module: product_attribute_value_sort_alphabetical
#: model:ir.model.fields,help:product_attribute_value_sort_alphabetical.field_product_attribute__keep_manual_sort
msgid ""
"Safety lock: freeze the current sequence of the values and allow to reorder "
"them manually, even if the alphabetical sort is enabled."
msgstr ""
"Sécurité : fige la séquence actuelle des valeurs et permet de les réordonner "
"manuellement, même si le tri alphabétique est activé."

#. module: product_attribute_value_sort_alphabetical
