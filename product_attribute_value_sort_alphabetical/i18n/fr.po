msgstr "Trier par ordre alphabétique"

#. module: product_attribute_value_sort_alphabetical
#: model:ir.model.fields,help:product_attribute_value_sort_alphabetical.field_product_attribute__sort_alphabetically
msgid "Values sequence is automatically computed in alphabetical order."
msgstr ""
"La séquence des valeurs est calculée automatiquement par ordre alphabétique."

