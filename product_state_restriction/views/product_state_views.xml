<odoo>
    <record id="view_product_state_form_restriction" model="ir.ui.view">
        <field name="name">product.state.form.restriction</field>
        <field name="model">product.state</field>
        <field name="inherit_id" ref="product_state.view_product_state_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/group[last()]" position="after">
                <group string="Restrictions">
                    <field name="restrict_sale" widget="boolean_toggle" />
                    <field name="restrict_manufacture" widget="boolean_toggle" />
                    <field name="restrict_outgoing" widget="boolean_toggle" />
                </group>
            </xpath>
        </field>
    </record>
</odoo>