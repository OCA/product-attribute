<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="uom_uom_tree" model="ir.ui.view">
        <field name="name">uom.uom.list</field>
        <field name="model">uom.uom</field>
        <field name="inherit_id" ref="uom.uom_uom_view_list" />
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field
                    name="alias_ids"
                    widget="many2many_tags"
                    domain="['|', ('uom_id', '=', id), ('uom_id', '=', False)]"
                />
            </field>
        </field>
    </record>

    <record id="uom_uom_form" model="ir.ui.view">
        <field name="name">uom.uom.form</field>
        <field name="model">uom.uom</field>
        <field name="inherit_id" ref="uom.uom_uom_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//group[@name='uom_details']" position="after">
                <group>
                    <field
                        name="alias_ids"
                        widget="many2many_tags"
                        context="{'default_uom_id': id}"
                        domain="['|', ('uom_id', '=', id), ('uom_id', '=', False)]"
                    />
                </group>
            </xpath>
        </field>
    </record>
</odoo>
