<odoo>
    <record model="ir.ui.view" id="product_packaging_template_form_view">
        <field name="model">product.packaging.template</field>
        <field name="arch" type="xml">
            <form>
                <header />
                <sheet>
                    <group>
                        <field name="product_tmpl_id" readonly="1" />
                        <field name="name" />
                        <field name="sequence" />
                        <field name="qty" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record model="ir.ui.view" id="product_packaging_template_tree_view">
        <field name="model">product.packaging.template</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle" />
                <field name="name" />
                <field name="qty" />
            </list>
        </field>
    </record>
</odoo>
