<odoo>
    <!-- Enable the parent category fallback so that the demo products of a
         category without its own prefix inherit the prefix of their parent. -->
    <record id="base.main_company" model="res.company">
        <field name="use_parent_categories_to_determine_prefix" eval="True" />
    </record>
</odoo>
