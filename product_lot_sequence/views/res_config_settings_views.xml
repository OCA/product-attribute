<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.stock</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="stock.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <block id="production_lot_info" position="inside">
                <setting id="lot_sequence_padding" help="Default number of digits to be set on products for product lot/serial sequence generation">
                    <field name="lot_sequence_padding" style="width: 3rem;"/>
                    <div class="d-inline-block">digits</div>
                </setting>
            </block>
        </field>
    </record>
</odoo>
