<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- view common to both template and product -->
    <record id="view_template_property_form" model="ir.ui.view">
        <field name="name">product.template.stock.property.form.inherit</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="stock.view_template_property_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_tooltip']" position="after">
                <div
                    class="o_horizontal_separator mt-4 mb-3 text-uppercase fw-bolder small"
                    colspan="2"
                    invisible="not display_lot_sequence_fields or lot_sequence_id"
                >
                <i class="fa fa-cogs me-1" aria-hidden="true" />
                    Lot sequence settings
                </div>
                <label
                    for="lot_sequence_id"
                    invisible="not display_lot_sequence_fields"
                />
                <div class="o_row">
                    <field
                        name="lot_sequence_id"
                        invisible="not display_lot_sequence_fields"
                    />
                    <button
                        name="create_lot_sequence"
                        icon="fa-plus"
                        type="object"
                        string="Create sequence"
                        class="oe_link"
                        groups="product.group_product_manager"
                        invisible="not display_lot_sequence_fields or lot_sequence_id"
                    />
                    <span class="fst-italic text-muted" invisible="not lot_sequence_id">
                        Next:
                        <field
                        name="lot_sequence_number_next"
                        readonly="1"
                        nolabel="1"
                        class="oe_inline"
                    />
                    </span>
                </div>
                <field
                    name="lot_sequence_prefix"
                    invisible="not display_lot_sequence_fields or lot_sequence_id"
                />
                <field
                    name="lot_sequence_padding"
                    invisible="not display_lot_sequence_fields or lot_sequence_id"
                />
                <field
                    name="lot_sequence_number_next"
                    readonly="lot_sequence_id"
                    invisible="not display_lot_sequence_fields or lot_sequence_id"
                />
                <separator
                    invisible="not display_lot_sequence_fields or lot_sequence_id"
                />
            </xpath>
        </field>
    </record>
</odoo>
