<odoo>
    <record id="product_template_form_view" model="ir.ui.view">
        <field name="name">product.template.form (ABC Classification)</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page
                    string="ABC Classification"
                    name="abc_classification"
                    invisible="not is_storable or (product_variant_count &gt; 1 and not is_product_variant)"
                >
                    <group>
                        <group>
                            <field
                                name="abc_classification_profile_ids"
                                widget="many2many_tags"
                            />
                        </group>
                    </group>
                    <field
                        name="abc_classification_product_level_ids"
                        context="{'default_product_tmpl_id': id, 'default_profile_id': abc_classification_profile_ids and abc_classification_profile_ids[0] or False}"
                        readonly="product_variant_count &gt; 1"
                    >
                        <list editable="bottom">
                            <field
                                name="profile_id"
                                domain="[('id', 'in', parent.abc_classification_profile_ids)]"
                            />
                            <field name="manual_level_id" />
                            <field name="computed_level_id" />
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
    <record id="product_template_only_form_view" model="ir.ui.view">
        <field name="name">product.template.product.form (ABC Classification)</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page
                    string="ABC Classification"
                    name="abc_classification_disabled"
                    invisible="not is_storable or product_variant_count &lt;= 1"
                >
                    <div>
                        <p>Each variant is classified on its own, on <button
                            name="action_open_abc_classification_variants"
                            type="object"
                            string="the product variants"
                            class="oe_link"
                        /></p>
                    </div>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
