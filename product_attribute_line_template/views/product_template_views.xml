<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record
        id="view_product_template_form_inherit_attribute_templates"
        model="ir.ui.view"
    >
        <field name="name">product.template.form.inherit.attribute.templates</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//page[@name='variants']" position="inside">
                <group string="Attribute templates">
                    <field
                        name="attribute_template_id"
                        domain="['|', ('company_id', '=', False), ('company_id', 'in', allowed_company_ids)]"
                    />
                </group>
            </xpath>
        </field>
    </record>
</odoo>
