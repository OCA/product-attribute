<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_move_form" model="ir.ui.view">
        <field name="name">account.move.form (product_state_account)</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="arch" type="xml">
            <xpath
                expr="//field[@name='invoice_line_ids']/list/field[@name='product_id']"
                position="attributes"
            >
                <attribute
                    name="domain"
                >context.get('default_move_type') in ('out_invoice', 'out_refund', 'out_receipt') and [('sale_ok', '=', True), ('product_state_can_be_invoiced', '=', True)] or [('purchase_ok', '=', True)]</attribute>
            </xpath>
        </field>
    </record>
</odoo>
