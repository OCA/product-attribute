<odoo>
    <record model="ir.ui.menu" id="menu_product_state">
        <field name="name">Product States</field>
        <field name="action" ref="product_state.action_product_state" />
        <field name="parent_id" ref="sale.prod_config_main" />
    </record>
    <record id="view_product_state_form" model="ir.ui.view">
        <field name="name">product.state.form (product_state_sale)</field>
        <field name="model">product.state</field>
        <field name="inherit_id" ref="product_state.view_product_state_form" />
        <field name="arch" type="xml">
            <field name="active" position="after">
                <field name="can_be_sold" widget="boolean_toggle" />
            </field>
        </field>
    </record>
    <record id="view_product_state_tree" model="ir.ui.view">
        <field name="name">product.state.list (product_state_sale)</field>
        <field name="model">product.state</field>
        <field name="inherit_id" ref="product_state.view_product_state_tree" />
        <field name="arch" type="xml">
            <field name="description" position="after">
                <field name="can_be_sold" optional="show" />
            </field>
        </field>
    </record>
</odoo>
