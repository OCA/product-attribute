<odoo>
    <record id="product_normal_form_view" model="ir.ui.view">
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view" />
        <field name="arch" type="xml">
            <page name="inventory" position="after">
                <page string="Nutrition">
                    <group>
                        <group>
                            <label for="nutritional_reference_qty" />
                            <div class="o_row">
                                <field name="nutritional_reference_qty" />
                                <field name="nutritional_reference_uom" />
                            </div>
                        </group>
                    </group>
                    <group>
                        <field
                            name="nutritional_value_ids"
                            nolabel="1"
                            options="{'no_create_edit': True}"
                        >
                            <list editable="bottom">
                                <field name="sequence" widget="handle" />
                                <field name="type_id" />
                                <field name="value" />
                            </list>
                        </field>
                    </group>
                </page>
            </page>
        </field>
    </record>

    <record id="product_template_only_form_view" model="ir.ui.view">
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view" />
        <field name="arch" type="xml">
            <page name="inventory" position="after">
                <page string="Nutrition" invisible="product_variant_count != 1">
                    <group>
                        <group>
                            <label for="nutritional_reference_qty" />
                            <div class="o_row">
                                <field name="nutritional_reference_qty" />
                                <field name="nutritional_reference_uom" />
                            </div>
                        </group>
                    </group>
                    <group>
                        <field
                            name="nutritional_value_ids"
                            nolabel="1"
                            options="{'no_create_edit': True}"
                        >
                            <list editable="bottom">
                                <field name="sequence" widget="handle" />
                                <field name="type_id" />
                                <field name="value" />
                            </list>
                        </field>
                    </group>
                </page>
            </page>
        </field>
    </record>
</odoo>
