<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field
            name="name"
        >res.config.settings.view.form.inherit.product.nutritional</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="product.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//block[@id='product_general_settings']" position="after">
                <block
                    title="Nutritional Information"
                    id="product_nutritional_general_settings"
                >
                    <setting
                        id="product_nutritional_types"
                        string="Configure your nutritional types"
                    >
                        <button
                            type="action"
                            name="%(nutritional_info.action_nutritional_type)d"
                            string="Nutritional Types"
                            class="oe_link"
                            icon="fa-arrow-right"
                        />
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
