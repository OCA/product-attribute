<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="product_template_form_view_inherit_value_group" model="ir.ui.view">
        <field name="name">product.template.form.inherit.value.group</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='attribute_line_ids']/tree/field[@name='value_ids']" position="before">
                <field name="value_group_id"
                       string="Value Group"
                       options="{'no_create': True, 'no_open': True}"
                       context="{'default_attribute_id': attribute_id}"
                       optional="show"/>
            </xpath>
        </field>
    </record>

</odoo>
