<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="product_attribute_value_group_view_tree" model="ir.ui.view">
        <field name="name">product.attribute.value.group.tree</field>
        <field name="model">product.attribute.value.group</field>
        <field name="arch" type="xml">
            <tree string="Attribute Value Groups">
                <field name="name"/>
                <field name="attribute_id"/>
                <field name="value_ids" widget="many2many_tags"/>
            </tree>
        </field>
    </record>

    <record id="product_attribute_value_group_view_form" model="ir.ui.view">
        <field name="name">product.attribute.value.group.form</field>
        <field name="model">product.attribute.value.group</field>
        <field name="arch" type="xml">
            <form string="Attribute Value Group">
                <sheet>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1>
                            <field name="name" placeholder="e.g. EU Men's Sizes"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="attribute_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Values" name="values">
                            <field name="value_ids"
                                   domain="[('attribute_id', '=', attribute_id)]"
                                   nolabel="1"
                                   widget="many2many_tags"
                                   options="{'no_create_edit': True}"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="product_attribute_value_group_view_search" model="ir.ui.view">
        <field name="name">product.attribute.value.group.search</field>
        <field name="model">product.attribute.value.group</field>
        <field name="arch" type="xml">
            <search string="Search Attribute Value Groups">
                <field name="name" string="Group Name"/>
                <field name="attribute_id"/>
                <group expand="0" string="Group By">
                    <filter string="Attribute" name="group_by_attribute" context="{'group_by': 'attribute_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="product_attribute_value_group_action" model="ir.actions.act_window">
        <field name="name">Attribute Value Groups</field>
        <field name="res_model">product.attribute.value.group</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="product_attribute_value_group_view_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new attribute value group
            </p><p>
                Value groups help you quickly select a predefined list of values when configuring product variants.
            </p>
        </field>
    </record>

    <menuitem
        id="menu_product_attribute_value_group"
        name="Value Groups"
        action="product_attribute_value_group_action"
        parent="sale.menu_product_catalog_config"
        sequence="15"/>

</odoo>
