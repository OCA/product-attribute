<odoo>
    <record id="group_product_creation" model="res.groups">
        <field name="name">Product Creation</field>
    </record>

    <record id="group_product_attribute_creation" model="res.groups">
        <field name="name">Product Attribute Creation</field>
    </record>

    <record id="group_product_tag_creation" model="res.groups">
        <field name="name">Product Tag Creation</field>
    </record>

    <record id="group_product_category_creation" model="res.groups">
        <field name="name">Product Category Creation</field>
    </record>

    <record id="group_product_supplierinfo_creation" model="res.groups">
        <field name="name">Product Supplier Pricelist Creation</field>
    </record>

    <record id="group_uom_creation" model="res.groups">
        <field name="name">Units of Measure Creation</field>
        <field name="implied_ids" eval="[Command.link(ref('uom.group_uom'))]" />
    </record>

    <record id="product.group_product_manager" model="res.groups">
        <field
            name="implied_ids"
            eval="[(4, ref('group_product_creation')), (4, ref('group_product_attribute_creation')), (4, ref('group_product_tag_creation')), (4, ref('group_product_category_creation')), (4, ref('group_product_supplierinfo_creation')), (4, ref('group_uom_creation'))]"
        />
    </record>
</odoo>
