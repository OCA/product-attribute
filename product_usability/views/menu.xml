<odoo>
    <menuitem
        id="menu_product_main"
        name="Products"
        sequence="10"
        web_icon="product_usability,static/description/product_menu_icon.png"
    />

    <!-- SECTION: Products -->
    <menuitem
        id="menu_product"
        name="Products"
        sequence="10"
        parent="menu_product_main"
    />

    <!-- Products -->
    <menuitem
        id="menu_product_template"
        sequence="10"
        parent="menu_product"
        action="product.product_template_action_all"
    />

    <!-- Product Variants -->
    <record id="product_normal_action" model="ir.actions.act_window">
        <field name="name">Product Variants</field>
        <field name="res_model">product.product</field>
        <field name="view_mode">kanban,list,form,activity</field>
        <field name="view_id" ref="product.product_kanban_view" />
        <field name="search_view_id" ref="product.product_search_form_view" />
    </record>

    <menuitem
        id="menu_product_product"
        sequence="20"
        parent="menu_product"
        action="product_normal_action"
        groups="product.group_product_variant"
    />

    <!-- Product Attributes -->
    <menuitem
        id="menu_product_attribute"
        sequence="30"
        parent="menu_product"
        action="product.attribute_action"
        groups="product.group_product_variant"
    />

    <!-- Pricelists -->
    <menuitem
        id="menu_product_pricelist"
        sequence="40"
        parent="menu_product"
        action="product.product_pricelist_action2"
        groups="product.group_product_pricelist"
    />

    <!-- SECTION: Configuration -->
    <menuitem
        id="menu_configuration"
        name="Configuration"
        sequence="100"
        parent="menu_product_main"
    />

    <!-- Product Categories -->
    <menuitem
        id="menu_product_category"
        sequence="10"
        parent="menu_configuration"
        action="product.product_category_action_form"
    />

    <!-- Product Tags -->
    <menuitem
        id="menu_product_tag"
        sequence="20"
        parent="menu_configuration"
        action="product.product_tag_action"
    />

    <!-- Units of Measure -->
    <menuitem
        id="menu_uom_uom"
        sequence="30"
        parent="menu_configuration"
        action="uom.uom_uom_action_list"
        groups="uom.group_uom"
    />
</odoo>
