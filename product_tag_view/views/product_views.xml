<odoo>
    <record id="product_template_form_view_inherit_tags" model="ir.ui.view">
        <field name="name">product.template.form.inherit</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view" />
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='categ_id']" position="after">
                <field
                    name="product_tag_ids"
                    widget="many2many_tags"
                    context="{'product_template_id': id}"
                />
            </xpath>
        </field>
    </record>
    <record id="product_normal_form_view_inherit_tags" model="ir.ui.view">
        <field name="name">product.product.form.inherit</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view" />
        <field name="priority">2</field>
        <field name="arch" type="xml">
            <!-- Restore under Sales tab: product_tag_ids is also added in General Information, so inherits match it first and place additional_product_tag_ids there. -->
            <xpath
                expr="//group[@name='sale']//field[@name='product_tag_ids']"
                position="after"
            >
                <field name="additional_product_tag_ids" widget="many2many_tags" />
            </xpath>
        </field>
    </record>
</odoo>
