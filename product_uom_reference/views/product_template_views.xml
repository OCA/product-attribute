<odoo>
    <record model="ir.ui.view" id="product_template_only_form_view">
        <field name="name">product.template.inherit.product_uom_reference_ratio</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view" />
        <field name="arch" type="xml">
            <xpath
                expr="//group[@name='group_standard_price']//div[@name='list_price_uom']"
                position="after"
            >
                <label for="uom_reference_id" />
                <div name="uom_reference_ratio">
                    <field
                        name="uom_reference_id"
                        class="oe_inline"
                        groups="uom.group_uom"
                        context="{'default_uom_id': uom_id}"
                    />
                </div>
            </xpath>
        </field>
    </record>
</odoo>
