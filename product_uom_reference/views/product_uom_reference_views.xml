<odoo>
    <record model="ir.ui.view" id="product_uom_reference_list_view">
        <field name="name">product.uom.reference.list</field>
        <field name="model">product.uom.reference</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name" />
                <field name="uom_id" />
                <field name="uom_reference_id" />
                <field name="ratio" />
            </list>
        </field>
    </record>

    <record id="product_uom_reference_act_window_list" model="ir.actions.act_window">
        <field name="name">UOM Reference</field>
        <field name="res_model">product.uom.reference</field>
        <field name="view_mode">list</field>
        <field name="view_id" ref="product_uom_reference_list_view" />
    </record>
</odoo>
