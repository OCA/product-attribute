<odoo>
    <record model="ir.ui.view" id="product_template_form_view">
        <field name="name">product.template.form.substate</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view" />
        <field name="arch" type="xml">
            <!-- <field name="product_state_id" position="after"> -->
            <xpath expr="//header" position="after">
                <header name="substate">
                    <field
                        name="substate_id"
                        widget="statusbar"
                        options="{'clickable': '1',}"
                        domain="[('model', '=', 'product.template'), ('target_state_value_id.target_state_value', '=', product_state_code)]"
                    />
                </header>
            </xpath>
        </field>
    </record>
</odoo>
