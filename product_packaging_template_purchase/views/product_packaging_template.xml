<odoo>
    <record model="ir.ui.view" id="product_packaging_template_form_view">
        <field name="model">product.packaging.template</field>
        <field
            name="inherit_id"
            ref="product_packaging_template.product_packaging_template_form_view"
        />
        <field name="arch" type="xml">
            <field name="qty" position="after">
                <field name="purchase" />
            </field>
        </field>
    </record>

    <record model="ir.ui.view" id="product_packaging_template_tree_view">
        <field name="model">product.packaging.template</field>
        <field
            name="inherit_id"
            ref="product_packaging_template.product_packaging_template_tree_view"
        />
        <field name="arch" type="xml">
            <field name="qty" position="after">
                <field name="purchase" />
            </field>
        </field>
    </record>
</odoo>
