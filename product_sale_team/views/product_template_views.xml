<odoo>
    <record id="product_template_sale_team_form_view" model="ir.ui.view">
        <field name="name">product.template.sale.team.form.view</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view" />
        <field name="arch" type="xml">
            <xpath
                expr="//page[@name='general_information']//field[@name='categ_id']"
                position="after"
            >
                <field name="sales_team_id" />
            </xpath>
        </field>
    </record>

    <record id="product_template_search_view_inherit_sales_team" model="ir.ui.view">
        <field name="name">product.template.search.view.inherit.sales_team</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_search_view" />
        <field name="arch" type="xml">
            <filter name="group_by_type" position="after">
                <filter
                    string="Sales Team"
                    name="filter_sales_team"
                    context="{'group_by':'sales_team_id'}"
                />
            </filter>
            <field name="product_tag_ids" position="after">
                <field name="sales_team_id" string="Sales Team" />
            </field>
        </field>
    </record>
</odoo>
