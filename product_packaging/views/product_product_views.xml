<odoo>
    <record id="product_variant_easy_edit_view" model="ir.ui.view">
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_variant_easy_edit_view" />
        <field name="arch" type="xml">
            <field name="uom_ids" position="attributes">
                <attribute name="invisible">1</attribute>
            </field>
            <group name="sales" position="after">
                <group
                    string="Packagings"
                    name="packagings"
                    colspan="2"
                    groups="uom.group_uom"
                >
                    <field
                        name="packaging_ids"
                        colspan="2"
                        nolabel="1"
                        force_save="1"
                        context="{'default_product_id': id, 'uom_inline_field_labels': True}"
                    />
                </group>
            </group>
        </field>
    </record>

    <record id="product_normal_form_view" model="ir.ui.view">
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view" />
        <field name="arch" type="xml">
            <field name="uom_ids" position="attributes">
                <attribute name="invisible">1</attribute>
            </field>
            <group name="packagings" position="attributes">
                <attribute name="invisible">0</attribute>
            </group>
            <field name="packaging_ids" position="attributes">
                <attribute
                    name="context"
                >{'default_product_id': id, 'uom_inline_field_labels': True}</attribute>
            </field>
        </field>
    </record>
</odoo>
