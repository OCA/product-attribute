<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.reservation.lead.time</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="stock.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <div id="annual_inventory_date" position="after">
                <div class="col-12 col-lg-6 o_setting_box" id="reservation_lead_days">
                    <div class="o_setting_right_pane">
                        <span class="o_form_label">Reservation Lead Time</span>
                        <span
                            class="fa fa-lg fa-building-o"
                            title="Values set here are company-specific."
                            groups="base.group_multi_company"
                        />
                        <div class="text-muted">
                            Default number of days before delivery to reserve stock
                            when a product category has no specific rule
                        </div>
                        <div class="content-group mt16">
                            <div class="row">
                                <label
                                    for="reservation_lead_days"
                                    string="Default lead time (days)"
                                    class="col-lg-8 o_light_label"
                                />
                                <field name="reservation_lead_days" />
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </field>
    </record>

</odoo>
