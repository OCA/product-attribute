msgstr "Plazo de reserva por defecto (días)"

#. module: product_category_reservation_lead_time
#: model:ir.model.fields,help:product_category_reservation_lead_time.field_res_company__reservation_lead_days
msgid ""
"Global reservation lead time used when a product's category (or its "
"ancestors) has no specific rule"
msgstr ""
"Plazo de reserva global usado cuando la categoría de un producto (o sus "
"ancestros) no tiene una regla propia"

#. module: product_category_reservation_lead_time
#: model:ir.model.constraint,message:product_category_reservation_lead_time.constraint_product_category_reservation_rule_category_company_uniq
msgid ""
"A reservation lead time rule already exists for this category and company"
msgstr ""
"Ya existe una regla de plazo de reserva para esta categoría y compañía"

#. module: product_category_reservation_lead_time
#: model:ir.model.constraint,message:product_category_reservation_lead_time.constraint_product_category_reservation_rule_reservation_days_positive
