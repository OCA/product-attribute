#. module: product_category_reservation_lead_time
#: model:ir.model.fields,help:product_category_reservation_lead_time.field_product_category_reservation_rule__reservation_days
msgid ""
"Number of days before the delivery date within which the line enters the "
"reservation window. 0 = reserve only on the delivery date."
msgstr ""
"Número de días antes de la fecha de entrega en los que la línea entra en la "
"ventana de reserva. 0 = reservar solo el día de la entrega."

