#: model_terms:ir.ui.view,arch_db:product_logistics_uom.product_template_form_view
msgid ""
"<i class=\"fa fa-fw fa-warning text-warning\" title=\"Value too small for "
"the selected uom. Select another uom to display the value.\"/>"
msgstr ""
"<i class=\"fa fa-fw fa-warning text-warning\" title=\"Vrednost je premajhna "
